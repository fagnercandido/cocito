{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capabilities da webview React (UI principal). Apenas plugins fs, dialog e updater — shell e notification foram removidos da app inteira porque os seus polyfills JS contaminavam as svc:* webviews. Notifs nativas vão por notify-rust direto no Cérbero.",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview",
    "core:webview:allow-webview-close",
    "core:webview:allow-webview-show",
    "core:webview:allow-webview-hide",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-reparent",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-set-fullscreen",

    "dialog:allow-open",

    "updater:default"
  ]
}
